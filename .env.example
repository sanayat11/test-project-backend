# ==========================================
# CreatorFlow Backend - Production Environment
# ==========================================

# Port the backend server should listen on
PORT=5000

# Node environment (production / development)
NODE_ENV=production

# PostgreSQL Connection String (e.g., Neon, Supabase, Render PostgreSQL)
DATABASE_URL="postgresql://postgres:password@ep-sample-123456.us-east-2.aws.neon.tech/creator_analytics?sslmode=require"

# Secret key for signing and verifying JWT tokens (Use a strong random 64-char string)
JWT_SECRET="your-super-secret-jwt-key-min-64-characters-production-secure"

# Allowed Frontend URL for CORS (comma-separated for multiple domains)
FRONTEND_URL="https://your-frontend-domain.vercel.app"
